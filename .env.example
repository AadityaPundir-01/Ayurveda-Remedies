# ===============================================
# Agentic AI Medical & Home Remedies Configuration
# ===============================================

# LLM Provider: 'groq' or 'gemini'
LLM_PROVIDER=groq

# Groq API Configuration
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Configuration (Free Tier)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Local Hugging Face Free Embedding Model
# This runs locally without any API key or cost
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=medical_home_remedies

# Server Settings
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=["*"]
